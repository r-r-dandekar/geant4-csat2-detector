# --- Build output ---
# Out-of-source build directories (any name/level)
build/
build*/
cmake-build-*/

# In-source CMake artifacts (in case cmake is ever run outside a build dir)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
CPack*.cmake
install_manifest.txt
CMakeUserPresets.json
compile_commands.json
Testing/
_deps/
Makefile

# Compiled objects, libraries and executables
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.lib
*.exe
*.out
dsim

# --- Python virtual environment ---
venv/
.venv/

# --- Python caches ---
__pycache__/
*.py[cod]

# Temporary sweep macros created by run_sweep.sh
sweep_*.mac

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*~

# --- OS ---
.DS_Store
Thumbs.db

# Results (they can be very big in size, so shouldn't be pushed to git)
results/